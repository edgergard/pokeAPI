{
  "name": "pokeapi-team-builder",
  "private": true,
  "homepage": "https://edgergard.github.io/pokeAPI",
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/flatten-rsc-segments.mjs out",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "movesets": "vite-node --config vitest.config.ts scripts/build-movesets.ts",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d out --nojekyll"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^5.9.2",
    "@tanstack/react-query": "^5.108.2",
    "clsx": "^2.1.1",
    "gsap": "^3.15.1",
    "lucide-react": "^1.77.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "three": "^0.187.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "gh-pages": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "5.8",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  }
}
